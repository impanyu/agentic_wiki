OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Generic external API execution: operator-controlled policy, no secret values here.
# Default denies all endpoints; see app/components-registry/API-EXECUTION.md.
COMPONENT_API_POLICY={"anonymous":[],"credentials":{}}
# Set actual COMPONENT_SECRET_* values only in .env.local or hosted server secrets.

# Isolated code and GUI sandboxes (optional). Keep the actual key in server secrets.
# Optional GUI desktop only; backend programs use OPENAI_API_KEY.
E2B_API_KEY=
# Optional comma-separated authenticated user IDs; empty permits signed-in users.
SANDBOX_ALLOWED_USERS=
# Desktop internet access is an operator setting, not controlled by generated code.
SANDBOX_GUI_INTERNET=false

# Per-user Google Drive authorization. Store real values as server secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64 encoding of a random 32-byte AES key; keep stable to decrypt saved tokens.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# General cloud storage connections. Values stay in server secrets.
STORAGE_TOKEN_ENCRYPTION_KEY=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# Optional hosted execution model; defaults to OPENAI_MODEL.
OPENAI_SANDBOX_MODEL=

# VM deployment: canonical public origin; never use an untrusted Host header.
APP_URL=http://localhost:3000
# Set for the public Docker Compose profile (without https://).
DOMAIN=wiki.example.com
# Native deployment only; Docker uses its named /app/data volume.
DATA_DIR=./data
PORT=3000
HOSTNAME=0.0.0.0
# Optional absolute overrides: DATABASE_PATH and FILES_PATH.
# Google login uses GOOGLE_CLIENT_ID/SECRET above and this callback:
# https://YOUR-DOMAIN/auth/google/callback
